<!DOCTYPE html>
<html>
    <head>
        <title>Circles</title>
        <style>
            .body{
                display: flex;
                justify-content: center;
                align-items: center;
                height: 50vh;
                background: #111;
            }
            .card{
                width: 300px;
                height: 300px;
                border-radius: 50%;
                transform-style: preserve-3d;
                background: linear-gradient(45deg, #dba213, #c0a022 );
                transition: all 1s ease-in-out;
                position: relative;
                perspective: 1000px;
                border: none;
               
            }
            .circles{
                width: 200px;
                height: 200px;
                top: 50px;
                left: 50px;
                border-radius: inherit;
                position: absolute;
                background: linear-gradient( #bcb74b , #b39c1b);
                border: none;
                box-shadow: -5px 5px 10px #64646f33;
                transition: all 1s ease-in-out;
                
            }
            .card:hover{
                transform: rotate3d(1,1,0,60deg);
            }
            .card:hover .circles:nth-child(1){
                transform: translate3d(0,0,30px);

            }

                
           
        </style>
    </head>
    <body>
        <div class="card">
            <div  class="circles" ></div>
            <div  class="circles" ></div>
            <div  class="circles" ></div>
            <div  class="circles" ></div>
            <div  class="circles" ></div>
            <div  class="circles" ></div>
            <div  class="circles" ></div>
        </div>
    </body>
</html>
